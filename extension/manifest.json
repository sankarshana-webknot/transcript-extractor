{
  "manifest_version": 3,
  "name": "Transcript Extractor",
  "version": "0.1.0",
  "description": "Extract finalized transcript lines from CaseViewNet and stream words over WebSocket.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.caseviewnet.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.caseviewnet.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}


